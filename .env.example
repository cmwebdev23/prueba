# --- Base de datos (Turso, plan gratuito) ---
# Sin estas variables se usa un SQLite local (file:local.db).
TURSO_DATABASE_URL=libsql://tu-bd-tu-usuario.turso.io
TURSO_AUTH_TOKEN=

# --- IA: rellena UNA de estas (la primera que exista es la que se usa) ---
# Vercel AI Gateway (incluye crédito gratuito mensual)
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=google/gemini-3.8-flash
# Google Gemini (gratis en https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
# Cualquier API compatible con OpenAI (p. ej. Groq, gratis: https://console.groq.com)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=llama-3.3-70b-versatile

# --- Acceso protegido (opcional). Si están, la app pide usuario y contraseña ---
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
